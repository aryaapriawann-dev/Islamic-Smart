{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/app/main.py" },
    { "source": "/(.*)", "destination": "/dashboard/$1" }
  ],
  "builds": [
    { "src": "dashboard/package.json", "use": "@vercel/next" },
    { "src": "backend/app/main.py", "use": "@vercel/python" }
  ]
}